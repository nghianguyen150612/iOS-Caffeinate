{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ios-caffeinate.invalid/schemas/evidence-manifest-v1.schema.json",
  "title": "iOS-Caffeinate deterministic evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "files"],
  "properties": {
    "manifest_version": {"type": "integer", "const": 1},
    "files": {
      "type": "array", "minItems": 1, "maxItems": 129,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["file_id", "path", "size_bytes", "sha256"],
        "properties": {
          "file_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "path": {"type": "string", "minLength": 1, "maxLength": 512},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
