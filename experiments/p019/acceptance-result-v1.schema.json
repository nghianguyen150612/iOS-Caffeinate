{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ios-caffeinate.invalid/schemas/p019-acceptance-result-v1.schema.json",
  "title": "P019 versioned decision result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_version", "protocol_id", "protocol_version", "session_id", "source_commit_sha", "status", "reason_codes", "gates", "tested_scope", "excluded_scope", "metrics", "p020_readiness", "hardware_acceptance", "cloud_status", "provenance_limits"],
  "properties": {
    "result_version": {"const": 1}, "protocol_id": {"const": "P019"}, "protocol_version": {"const": 1},
    "session_id": {"type": "string"}, "source_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "status": {"enum": ["NOT_STARTED", "PREREQUISITES_BLOCKED", "READY_FOR_ATTENDED_TEST", "IN_PROGRESS", "INCOMPLETE", "FAILED_SAFETY", "INCONCLUSIVE", "EVIDENCE_REVIEW_PENDING", "ACCEPTED_FOR_TESTED_SCOPE"]},
    "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "gates": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["gate_id", "status", "reason", "provenance"], "properties": {"gate_id": {"type": "string"}, "status": {"enum": ["PASS", "PENDING", "BLOCKED", "INCONCLUSIVE", "NOT_APPLICABLE"]}, "reason": {"type": "string"}, "provenance": {"type": "string"}}}},
    "tested_scope": {"type": "array", "items": {"type": "string"}}, "excluded_scope": {"type": "array", "items": {"type": "string"}},
    "metrics": {"type": "object", "additionalProperties": false, "required": ["planned_trials", "attempted_trials", "valid_trials", "invalid_trials", "incomplete_trials", "interrupted_trials", "successful_bounded_holds", "confirmed_releases", "p012_confirmed_releases", "p012_release_failures", "release_failures", "unexpected_daemon_exits", "unexpected_restarts", "lan_authenticated_successes", "lan_authenticated_failures", "tailscale_authenticated_successes", "tailscale_authenticated_failures", "supervised_observation_seconds", "resource_availability", "p012_comparisons", "lan", "tailscale", "charging_state_categories", "protocol_deviations", "missing_p009_evidence_purposes", "p009_evidence_issues", "p018_export_issues", "remaining_acceptance_gates"], "properties": {"planned_trials": {"type": "integer", "minimum": 0}, "attempted_trials": {"type": "integer", "minimum": 0}, "valid_trials": {"type": "integer", "minimum": 0}, "invalid_trials": {"type": "integer", "minimum": 0}, "incomplete_trials": {"type": "integer", "minimum": 0}, "interrupted_trials": {"type": "integer", "minimum": 0}, "successful_bounded_holds": {"type": "integer", "minimum": 0}, "confirmed_releases": {"type": "integer", "minimum": 0}, "p012_confirmed_releases": {"type": "integer", "minimum": 0}, "p012_release_failures": {"type": "integer", "minimum": 0}, "release_failures": {"type": "integer", "minimum": 0}, "unexpected_daemon_exits": {"type": "integer", "minimum": 0}, "unexpected_restarts": {"type": "integer", "minimum": 0}, "lan_authenticated_successes": {"type": "integer", "minimum": 0}, "lan_authenticated_failures": {"type": "integer", "minimum": 0}, "tailscale_authenticated_successes": {"type": "integer", "minimum": 0}, "tailscale_authenticated_failures": {"type": "integer", "minimum": 0}, "supervised_observation_seconds": {"type": "integer", "minimum": 0}, "resource_availability": {"type": "object", "additionalProperties": false, "required": ["battery_api_available", "battery_api_unavailable", "thermal_api_available", "thermal_api_unavailable", "operator_observations"], "properties": {"battery_api_available": {"type": "integer", "minimum": 0}, "battery_api_unavailable": {"type": "integer", "minimum": 0}, "thermal_api_available": {"type": "integer", "minimum": 0}, "thermal_api_unavailable": {"type": "integer", "minimum": 0}, "operator_observations": {"type": "integer", "minimum": 0}}}, "p012_comparisons": {"type": "array", "items": {"type": "object"}}, "lan": {"$ref": "#/$defs/routeSummary"}, "tailscale": {"$ref": "#/$defs/routeSummary"}, "charging_state_categories": {"type": "array", "items": {"type": "string"}}, "protocol_deviations": {"type": "integer", "minimum": 0}, "missing_p009_evidence_purposes": {"type": "array", "items": {"type": "string"}}, "p009_evidence_issues": {"type": "array", "items": {"type": "string"}}, "p018_export_issues": {"type": "array", "items": {"type": "string"}}, "remaining_acceptance_gates": {"type": "array", "items": {"type": "string"}}}},
    "p020_readiness": {"enum": ["ASSESSABLE_FROM_CLOUD", "BLOCKED_PENDING_PHYSICAL_ACCEPTANCE", "BLOCKED_BY_SAFETY", "BLOCKED_BY_PROVENANCE"]},
    "hardware_acceptance": {"enum": ["NOT_ESTABLISHED", "ACCEPTED_FOR_TESTED_SCOPE"]},
    "cloud_status": {"const": "P019_CLOUD_COMPLETE_HARDWARE_ACCEPTANCE_PENDING"},
    "provenance_limits": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "analysis": {"type": "object"},
    "p009_review": {"type": "object"},
    "p018_export_review": {"type": "object"}
  },
  "$defs": {
    "routeSummary": {"type": "object", "additionalProperties": false, "required": ["attempted", "authenticated_successes", "authenticated_failures", "outcomes", "successful_latency_ms"], "properties": {"attempted": {"type": "integer", "minimum": 0}, "authenticated_successes": {"type": "integer", "minimum": 0}, "authenticated_failures": {"type": "integer", "minimum": 0}, "outcomes": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}, "successful_latency_ms": {"type": "object", "additionalProperties": false, "required": ["n", "median", "p25", "p75", "min", "max"], "properties": {"n": {"type": "integer", "minimum": 0}, "median": {"type": ["number", "null"]}, "p25": {"type": ["number", "null"]}, "p75": {"type": ["number", "null"]}, "min": {"type": ["number", "null"]}, "max": {"type": ["number", "null"]}}}}}
  }
}
