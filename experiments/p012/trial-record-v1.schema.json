{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ios-caffeinate.invalid/schemas/p012-trial-record-v1.schema.json",
  "title": "P012 operator-reported trial record v1",
  "description": "One condition and one route per trial. P012 records are separate from P009 acceptance sessions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_version", "evidence_origin", "trial_id", "repetition", "pair_id", "condition_id", "route", "condition_order_index", "route_order_index", "trial_started_at_utc", "trial_ended_at_utc", "observer_timebase_id", "timing_uncertainty_ms", "device_timebase_id", "device_clock_uncertainty_ms", "state", "operator_confirmations", "probe", "interrupted", "interruption_code"],
  "properties": {
    "record_version": {"const": 1},
    "evidence_origin": {"enum": ["SIMULATED", "MOCK", "CI", "DEVICE_REPORTED", "EXTERNAL_OBSERVER", "OPERATOR_RECORDED"]},
    "trial_id": {"$ref": "#/$defs/id"},
    "repetition": {"type": ["integer", "null"], "minimum": 1, "maximum": 3},
    "pair_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
    "condition_id": {"type": ["string", "null"], "enum": ["A", "B", "C", "D", null]},
    "route": {"type": ["string", "null"], "enum": ["LAN", "TAILSCALE", null]},
    "condition_order_index": {"type": ["integer", "null"], "minimum": 1, "maximum": 4},
    "route_order_index": {"type": ["integer", "null"], "minimum": 1, "maximum": 2},
    "trial_started_at_utc": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
    "trial_ended_at_utc": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
    "observer_timebase_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
    "timing_uncertainty_ms": {"type": ["integer", "null"], "minimum": 0, "maximum": 86400000},
    "device_timebase_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
    "device_clock_uncertainty_ms": {"type": ["integer", "null"], "minimum": 0, "maximum": 86400000},
    "state": {"$ref": "#/$defs/state"},
    "operator_confirmations": {"$ref": "#/$defs/confirmations"},
    "probe": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/probe"}]},
    "interrupted": {"type": "boolean"},
    "interruption_code": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "nullableBoolean": {"type": ["boolean", "null"]},
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["screen_lock_status", "screen_lock_observed_at_utc", "charging_state", "battery_percent", "battery_observed_at_utc", "thermal_state", "thermal_observed_at_utc", "wifi_association", "wifi_profile_id", "lan_route_state", "tailscale_route_state", "daemon_state", "assertion_state", "assertion_duration_seconds", "assertion_acquire_result", "assertion_acquire_started_at_utc", "assertion_acquired_at_utc", "assertion_release_result", "assertion_release_kind", "assertion_release_confirmed_at_utc", "quiet_start_at_utc", "quiet_end_at_utc", "quiet_interval_seconds", "quiet_period_confirmed", "quiet_period_contaminated", "quiet_incoming_probe_count", "quiet_operator_interaction_count", "elapsed_since_previous_trial_seconds", "reboot_or_respring_since_previous"],
      "properties": {
        "screen_lock_status": {"enum": ["LOCKED", "UNLOCKED", "UNKNOWN"]},
        "screen_lock_observed_at_utc": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
        "charging_state": {"enum": ["CHARGING", "NOT_CHARGING", "UNKNOWN"]},
        "battery_percent": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "battery_observed_at_utc": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
        "thermal_state": {"enum": ["COOL", "WARM", "HOT", "UNKNOWN"]},
        "thermal_observed_at_utc": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
        "wifi_association": {"enum": ["ASSOCIATED", "DISCONNECTED", "UNKNOWN"]},
        "wifi_profile_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
        "lan_route_state": {"enum": ["AVAILABLE", "UNAVAILABLE", "UNKNOWN"]},
        "tailscale_route_state": {"enum": ["AVAILABLE", "UNAVAILABLE", "UNKNOWN"]},
        "daemon_state": {"enum": ["STOPPED", "RUNNING_IDLE", "RUNNING_HOLD", "UNKNOWN"]},
        "assertion_state": {"enum": ["INACTIVE", "ACTIVE", "EXPIRED_RELEASED", "UNKNOWN"]},
        "assertion_duration_seconds": {"type": ["integer", "null"], "minimum": 0, "maximum": 300},
        "assertion_acquire_result": {"enum": ["SUCCESS", "FAILURE", "NOT_APPLICABLE", "UNKNOWN"]},
        "assertion_acquire_started_at_utc": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
        "assertion_acquired_at_utc": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
        "assertion_release_result": {"enum": ["SUCCESS", "FAILURE", "NOT_APPLICABLE", "UNKNOWN"]},
        "assertion_release_kind": {"enum": ["EXPIRED", "EXPLICIT", "NONE", "UNKNOWN"]},
        "assertion_release_confirmed_at_utc": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
        "quiet_start_at_utc": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
        "quiet_end_at_utc": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
        "quiet_interval_seconds": {"type": ["integer", "null"], "minimum": 60, "maximum": 180},
        "quiet_period_confirmed": {"$ref": "#/$defs/nullableBoolean"},
        "quiet_period_contaminated": {"$ref": "#/$defs/nullableBoolean"},
        "quiet_incoming_probe_count": {"type": ["integer", "null"], "minimum": 0},
        "quiet_operator_interaction_count": {"type": ["integer", "null"], "minimum": 0},
        "elapsed_since_previous_trial_seconds": {"type": ["number", "null"], "minimum": 0},
        "reboot_or_respring_since_previous": {"enum": [true, false, "UNKNOWN"]}
      }
    },
    "confirmations": {
      "type": "object", "additionalProperties": false,
      "required": ["operator_present", "direct_recovery_available", "p011_stable_package_preflight_passed", "package_installation_separately_authorized", "installed_runtime_verified", "assertion_acquire_release_cleanup_verified", "battery_thermal_safe", "screen_locked", "wifi_association_confirmed", "route_state_confirmed", "daemon_state_confirmed", "assertion_state_confirmed", "trial_order_followed"],
      "properties": {
        "operator_present": {"$ref": "#/$defs/nullableBoolean"},
        "direct_recovery_available": {"$ref": "#/$defs/nullableBoolean"},
        "p011_stable_package_preflight_passed": {"$ref": "#/$defs/nullableBoolean"},
        "package_installation_separately_authorized": {"$ref": "#/$defs/nullableBoolean"},
        "installed_runtime_verified": {"$ref": "#/$defs/nullableBoolean"},
        "assertion_acquire_release_cleanup_verified": {"$ref": "#/$defs/nullableBoolean"},
        "battery_thermal_safe": {"$ref": "#/$defs/nullableBoolean"},
        "screen_locked": {"$ref": "#/$defs/nullableBoolean"},
        "wifi_association_confirmed": {"$ref": "#/$defs/nullableBoolean"},
        "route_state_confirmed": {"$ref": "#/$defs/nullableBoolean"},
        "daemon_state_confirmed": {"$ref": "#/$defs/nullableBoolean"},
        "assertion_state_confirmed": {"$ref": "#/$defs/nullableBoolean"},
        "trial_order_followed": {"$ref": "#/$defs/nullableBoolean"}
      }
    },
    "probe": {
      "type": "object", "additionalProperties": false,
      "required": ["probe_version", "trial_id", "condition_id", "repetition", "route", "target_id", "result", "authentication", "authenticated", "ssh_exit_code", "started_at_utc", "ended_at_utc", "elapsed_ms", "wall_elapsed_ms", "clock_discontinuity", "timeout_seconds", "quiet_interval_seconds", "quiet_period_confirmed", "screen_lock_status", "screen_lock_confirmed", "operator_present", "p011_prerequisites_confirmed", "physical_recovery_confirmed", "battery_thermal_approved", "wifi_association_confirmed", "route_state_confirmed", "daemon_state_confirmed", "assertion_state_confirmed", "observer_timebase_id", "timing_uncertainty_ms"],
      "properties": {
        "probe_version": {"const": 1}, "trial_id": {"$ref": "#/$defs/id"}, "condition_id": {"enum": ["A", "B", "C", "D"]},
        "repetition": {"type": "integer", "minimum": 1, "maximum": 3}, "route": {"enum": ["LAN", "TAILSCALE"]}, "target_id": {"$ref": "#/$defs/id"},
        "result": {"enum": ["AUTHENTICATED_SUCCESS", "AUTHENTICATION_FAILURE", "PROBE_TIMEOUT", "CONNECTION_REFUSED", "HOST_KEY_FAILURE", "INTERRUPTED", "TRANSPORT_ERROR", "REMOTE_COMMAND_FAILURE", "SSH_CLIENT_MISSING"]},
        "authentication": {"enum": ["SUCCESS", "FAILURE", "NOT_ESTABLISHED", "UNKNOWN"]}, "authenticated": {"type": ["boolean", "null"]},
        "ssh_exit_code": {"type": ["integer", "null"]}, "started_at_utc": {"$ref": "#/$defs/timestamp"}, "ended_at_utc": {"$ref": "#/$defs/timestamp"},
        "elapsed_ms": {"type": "number", "minimum": 0}, "wall_elapsed_ms": {"type": "number"}, "clock_discontinuity": {"type": "boolean"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 15}, "quiet_interval_seconds": {"type": "integer", "minimum": 30, "maximum": 300},
        "quiet_period_confirmed": {"type": "boolean"}, "screen_lock_status": {"enum": ["LOCKED", "UNLOCKED", "UNKNOWN"]}, "screen_lock_confirmed": {"type": "boolean"},
        "operator_present": {"type": "boolean"}, "p011_prerequisites_confirmed": {"type": "boolean"}, "physical_recovery_confirmed": {"type": "boolean"},
        "battery_thermal_approved": {"type": "boolean"}, "wifi_association_confirmed": {"type": "boolean"}, "route_state_confirmed": {"type": "boolean"},
        "daemon_state_confirmed": {"type": "boolean"}, "assertion_state_confirmed": {"type": "boolean"},
        "observer_timebase_id": {"$ref": "#/$defs/id"}, "timing_uncertainty_ms": {"type": "integer", "minimum": 0, "maximum": 86400000}
      }
    }
  }
}
