{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ios-caffeinate.invalid/schemas/p012-protocol-v1.schema.json",
  "title": "P012 preregistered controlled idle protocol v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_id", "protocol_version", "protocol_status", "preregistered_on", "target_platform", "research_questions", "conditions", "assertion", "quiet_period", "probe", "design", "required_operator_confirmations", "inclusion_criteria", "exclusion_criteria", "stop_conditions", "recovery_requirements", "data_retention", "p011_prerequisite", "known_sources_of_bias", "evidence_source_classes", "p009_mapping"],
  "properties": {
    "protocol_id": {"const": "P012"},
    "protocol_version": {"const": 1},
    "protocol_status": {"const": "PREREGISTERED_PROPOSAL"},
    "preregistered_on": {"type": "string", "format": "date"},
    "target_platform": {"type": "object", "required": ["device", "soc", "ios", "bootstrap"], "additionalProperties": false, "properties": {"device": {"type": "string"}, "soc": {"type": "string"}, "ios": {"type": "string"}, "bootstrap": {"type": "string"}}, "minProperties": 4, "maxProperties": 4},
    "research_questions": {"const": ["RQ1", "RQ2", "RQ3", "RQ4"]},
    "conditions": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "required": ["id", "name", "daemon_state", "assertion_state", "definition"], "additionalProperties": false, "properties": {"id": {"enum": ["A", "B", "C", "D"]}, "name": {"type": "string"}, "daemon_state": {"enum": ["STOPPED", "RUNNING_IDLE", "RUNNING_HOLD"]}, "assertion_state": {"enum": ["INACTIVE", "ACTIVE", "EXPIRED_RELEASED"]}, "definition": {"type": "string"}}}},
    "assertion": {"type": "object", "required": ["active_hold_seconds", "maximum_hold_seconds", "measurement_must_precede_expiry", "actual_acquisition_and_release_confirmation_required"], "additionalProperties": false, "properties": {"active_hold_seconds": {"type": "integer", "minimum": 1, "maximum": 300}, "maximum_hold_seconds": {"type": "integer", "minimum": 1, "maximum": 300}, "measurement_must_precede_expiry": {"const": true}, "actual_acquisition_and_release_confirmation_required": {"const": true}}},
    "quiet_period": {"type": "object", "required": ["seconds", "minimum_seconds", "maximum_seconds", "required_before_each_probe", "incoming_ssh_probes_allowed", "operator_interactions_allowed"], "additionalProperties": false, "properties": {"seconds": {"type": "integer", "minimum": 60, "maximum": 180}, "minimum_seconds": {"type": "integer", "minimum": 60, "maximum": 180}, "maximum_seconds": {"type": "integer", "minimum": 60, "maximum": 180}, "required_before_each_probe": {"const": true}, "incoming_ssh_probes_allowed": {"const": false}, "operator_interactions_allowed": {"const": false}}},
    "probe": {"type": "object", "required": ["timeout_seconds", "maximum_timeout_seconds", "maximum_probes_per_trial", "remote_command", "ssh_options"], "additionalProperties": false, "properties": {"timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 15}, "maximum_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 15}, "maximum_probes_per_trial": {"const": 1}, "remote_command": {"const": "true"}, "ssh_options": {"type": "array", "items": {"type": "string"}, "minItems": 3, "maxItems": 8}}},
    "design": {"type": "object", "required": ["repetitions_per_condition_per_route", "routes", "one_route_per_trial", "pairing_rule", "total_planned_probe_trials", "route_order_by_repetition", "condition_order_by_repetition", "automated_physical_trial_series", "interpretation"], "additionalProperties": false, "properties": {"repetitions_per_condition_per_route": {"type": "integer", "minimum": 3, "maximum": 3}, "routes": {"const": ["LAN", "TAILSCALE"]}, "one_route_per_trial": {"const": true}, "pairing_rule": {"const": "Pair route trials by condition and repetition using one sanitized pair_id; assign a distinct trial_id to each route trial."}, "total_planned_probe_trials": {"const": 24}, "route_order_by_repetition": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["LAN", "TAILSCALE"]}}}, "condition_order_by_repetition": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["A", "B", "C", "D"]}}}, "automated_physical_trial_series": {"const": false}, "interpretation": {"type": "string"}}},
    "required_operator_confirmations": {"type": "array", "minItems": 12, "uniqueItems": true, "items": {"type": "string"}},
    "inclusion_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "exclusion_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "recovery_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "data_retention": {"type": "object", "required": ["retain", "exclude", "operator_storage"], "additionalProperties": false, "properties": {"retain": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "exclude": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "operator_storage": {"type": "string"}}},
    "p011_prerequisite": {"type": "object", "required": ["required_before_hardware_trials", "current_status", "note"], "additionalProperties": false, "properties": {"required_before_hardware_trials": {"const": true}, "current_status": {"enum": ["PENDING", "PASS"]}, "note": {"type": "string"}}},
    "known_sources_of_bias": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence_source_classes": {"const": ["SIMULATED", "MOCK", "CI", "DEVICE_REPORTED", "EXTERNAL_OBSERVER", "OPERATOR_RECORDED"]},
    "p009_mapping": {"type": "object", "required": ["schema_version", "emit_only_explicitly_timestamped_events", "do_not_create_full_acceptance_session", "unsupported_trial_states", "limitation"], "additionalProperties": false, "properties": {"schema_version": {"const": 1}, "emit_only_explicitly_timestamped_events": {"const": true}, "do_not_create_full_acceptance_session": {"const": true}, "unsupported_trial_states": {"type": "array", "items": {"type": "string"}}, "limitation": {"type": "string"}}}
  }
}
