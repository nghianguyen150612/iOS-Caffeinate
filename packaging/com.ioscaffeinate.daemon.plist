<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ioscaffeinate.daemon</string>
  <!-- Do NOT activate before physical runtime validation. -->
  <key>Disabled</key><true/>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/ios-caffeinated</string>
    <string>--foreground</string>
  </array>
  <key>RunAtLoad</key><false/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/var/log/ioscaffeinate/daemon.log</string>
  <key>StandardErrorPath</key><string>/var/log/ioscaffeinate/daemon.err</string>
</dict>
</plist>
